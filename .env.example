# Токен Telegram-бота, выданный @BotFather
BOT_TOKEN=your_telegram_bot_token_here

# ID администраторов через запятую (узнать свой ID можно у @userinfobot)
ADMIN_IDS=123456789

# Часовой пояс (например, Asia/Yekaterinburg, Europe/Moscow)
TIMEZONE=Asia/Yekaterinburg

# Путь к файлу базы данных SQLite
DB_PATH=data/buton.db

# Папка для хранения фото букетов
PHOTOS_DIR=data/photos

# Папка для резервных копий БД
BACKUP_DIR=backup

# Максимальный размер фото букета в мегабайтах
MAX_PHOTO_SIZE_MB=5

# Телефон магазина (показывается клиенту, если заказ нельзя отменить)
SHOP_PHONE=+7 (900) 000-00-00

# Через сколько часов после "новой" заявки слать менеджеру повторное уведомление
MANAGER_REMINDER_HOURS=2

# Сколько последних резервных копий БД хранить
BACKUP_KEEP_COUNT=30

# Время ежедневного бэкапа и проверки напоминаний (формат HH:MM, по часовому поясу TIMEZONE)
BACKUP_TIME=03:00
REMINDER_CHECK_TIME=09:00
